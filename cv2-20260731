<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Calculadora de receita — doadores regulares</title>
<style>
  :root{
    --ink:#1c2b26; --ink-soft:#5a6b64; --paper:#fafbf9; --card:#ffffff;
    --line:#e3e8e4; --accent:#0f6b5c; --accent-soft:#e3f0ec;
    --gold:#c9a227; --edit:#fff3c4; --edit-border:#e6d27a;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    background:var(--paper);color:var(--ink);padding:32px 20px 56px;line-height:1.45;
  }
  .wrap{max-width:900px;margin:0 auto}
  .eyebrow{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:600;margin-bottom:6px}
  h1{font-size:26px;font-weight:700;letter-spacing:-.01em;margin-bottom:6px}
  .sub{color:var(--ink-soft);font-size:14px;max-width:680px;margin-bottom:28px}

  .panel{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:20px 22px;margin-bottom:20px}
  .panel h2{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);font-weight:600;margin-bottom:14px}

  .inputs{display:grid;grid-template-columns:repeat(auto-fit,minmax(175px,1fr));gap:16px}
  .field label{display:block;font-size:12.5px;color:var(--ink-soft);margin-bottom:5px}
  .field input,.field select{
    width:100%;padding:9px 10px;font-size:16px;font-weight:600;color:var(--ink);
    background:var(--edit);border:1px solid var(--edit-border);border-radius:6px;outline:none;
    font-variant-numeric:tabular-nums;
  }
  .field input:focus,.field select:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--accent-soft)}
  .hint{font-size:11.5px;color:var(--ink-soft);margin-top:4px}

  .headline{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:14px;margin-bottom:20px}
  .stat{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:16px 18px}
  .stat .k{font-size:12px;color:var(--ink-soft);margin-bottom:4px}
  .stat .v{font-size:23px;font-weight:700;font-variant-numeric:tabular-nums;letter-spacing:-.01em}
  .stat.main{border-color:var(--accent);background:var(--accent-soft)}
  .stat.main .v{color:var(--accent)}

  .tscroll{overflow-x:auto}
  table{width:100%;border-collapse:collapse;font-size:13.5px;min-width:640px}
  th,td{padding:9px 10px;text-align:right;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums;white-space:nowrap}
  th:first-child,td:first-child{text-align:left}
  th{font-size:11px;letter-spacing:.05em;text-transform:uppercase;color:var(--ink-soft);font-weight:600}
  td.cum{font-weight:700;color:var(--accent)}
  tr:last-child td{border-bottom:none}

  .legend{display:flex;gap:18px;flex-wrap:wrap;font-size:12.5px;color:var(--ink-soft);margin-top:10px;justify-content:center}
  .legend span{display:inline-flex;align-items:center;gap:6px}
  .sw{width:12px;height:12px;border-radius:3px;display:inline-block}

  .note{font-size:12.5px;color:var(--ink-soft);border-left:3px solid var(--edit-border);padding:8px 12px;background:#fffbe9;border-radius:0 6px 6px 0;margin-top:16px}
  @media (max-width:560px){ h1{font-size:22px} .stat .v{font-size:19px} }
</style>
</head>
<body>
<div class="wrap">
  <div class="eyebrow">Projeção de receita · out. 2026 – dez. 2029</div>
  <h1>Objetivo de receita — novos doadores regulares</h1>
  <p class="sub">Projeção da receita gerada exclusivamente por novos doadores que aderem entre <strong>outubro de 2026</strong> e <strong>dezembro de 2029</strong>. Doadores anuais pagam à cabeça em cada adesão/renovação; doadores mensais (débito direto) acumulam 1/12 do valor por mês, com desconto de pagamentos perdidos. O churn aplica-se no aniversário. Edita as células amarelas — tudo recalcula automaticamente.</p>

  <div class="panel">
    <h2>Pressupostos</h2>
    <div class="inputs">
      <div class="field">
        <label for="target">Doadores ativos no fim de 2029</label>
        <input id="target" type="number" value="200" min="10" step="10">
      </div>
      <div class="field">
        <label for="gift">Donativo anual médio (€)</label>
        <input id="gift" type="number" value="200" min="10" step="10">
      </div>
      <div class="field">
        <label for="churn">Churn anual (%)</label>
        <input id="churn" type="number" value="10" min="0" max="60" step="1">
        <div class="hint">Aplicado na renovação/aniversário</div>
      </div>
      <div class="field">
        <label for="pctm">Adesões em débito direto mensal (%)</label>
        <input id="pctm" type="number" value="60" min="0" max="100" step="5">
        <div class="hint">Restantes pagam anualmente à cabeça</div>
      </div>
      <div class="field">
        <label for="loss">Pagamentos perdidos — DD mensal (%)</label>
        <input id="loss" type="number" value="5" min="0" max="30" step="1">
        <div class="hint">Cobranças falhadas não recuperadas</div>
      </div>
      <div class="field">
        <label for="ramp">Ritmo de angariação</label>
        <select id="ramp">
          <option value="constant">Constante (39 meses)</option>
          <option value="linear">Crescente (rampa linear)</option>
        </select>
        <div class="hint">Rampa: arranque lento, acelera até 2029</div>
      </div>
    </div>
  </div>

  <div class="headline">
    <div class="stat main"><div class="k">Receita acumulada até dez. 2029</div><div class="v" id="hlCum">—</div></div>
    <div class="stat"><div class="k">Receita do ano 2029</div><div class="v" id="hlRun">—</div></div>
    <div class="stat"><div class="k">Run-rate em regime de cruzeiro</div><div class="v" id="hlSS">—</div></div>
    <div class="stat"><div class="k">Novos doadores a angariar (bruto)</div><div class="v" id="hlGross">—</div></div>
  </div>

  <div class="panel">
    <h2>Receita por ano civil</h2>
    <div class="tscroll">
    <table id="tbl">
      <thead>
        <tr><th>Ano</th><th>Novas adesões</th><th>Receita DD mensal</th><th>Receita anual à cabeça</th><th>Receita do ano</th><th>Receita acumulada</th><th>Ativos no fim do ano</th></tr>
      </thead>
      <tbody></tbody>
    </table>
    </div>
  </div>

  <div class="panel">
    <h2>Receita anual e acumulada</h2>
    <div id="chart"></div>
    <div class="legend">
      <span><i class="sw" style="background:#0f6b5c"></i>DD mensal</span>
      <span><i class="sw" style="background:#7fb3a5"></i>Anual à cabeça</span>
      <span><i class="sw" style="background:#c9a227"></i>Receita acumulada</span>
    </div>
    <div class="note">As projeções são hipóteses de trabalho do consultor calibradas para a meta definida, não benchmarks de mercado nem promessas de resultado. Os pagamentos perdidos são tratados como perda de receita, não como churn (o doador mantém-se ativo). O modelo cobre apenas novos doadores angariados a partir de outubro de 2026 — a base atual de membros não está incluída.</div>
  </div>
</div>

<script>
const MONTHS = 39, T = 38; // out 2026 (0) … dez 2029 (38)
const YEARS = [
  {label:"2026 (out–dez)", from:0,  to:2},
  {label:"2027",           from:3,  to:14},
  {label:"2028",           from:15, to:26},
  {label:"2029",           from:27, to:38},
];
const fmtEUR = v => v.toLocaleString("pt-PT",{style:"currency",currency:"EUR",maximumFractionDigits:0});
const fmtK   = v => (v/1000).toLocaleString("pt-PT",{maximumFractionDigits:0}) + " k€";
const fmtN   = v => Math.round(v).toLocaleString("pt-PT");

function simulate(){
  const target = Math.max(1, +document.getElementById("target").value || 0);
  const gift   = Math.max(0, +document.getElementById("gift").value   || 0);
  const churn  = Math.min(.99, Math.max(0,(+document.getElementById("churn").value||0)/100));
  const pctM   = Math.min(1,   Math.max(0,(+document.getElementById("pctm").value ||0)/100));
  const loss   = Math.min(.5,  Math.max(0,(+document.getElementById("loss").value ||0)/100));
  const ramp   = document.getElementById("ramp").value;
  const r = 1 - churn;

  // Perfil de angariação e calibração para a meta de ativos em dez. 2029
  const w = []; for (let m=0;m<MONTHS;m++) w.push(ramp==="linear" ? m+1 : 1);
  let apu = 0; for (let m=0;m<MONTHS;m++) apu += w[m]*Math.pow(r, Math.floor((T-m)/12));
  const scale = target/apu;
  const a = w.map(x=>x*scale);

  // Pagamentos mês a mês
  const payA = new Array(MONTHS).fill(0);   // anual à cabeça
  const payM = new Array(MONTHS).fill(0);   // débito direto mensal (líquido de perdidos)
  for (let m=0;m<MONTHS;m++){
    const aA = a[m]*(1-pctM), aM = a[m]*pctM;
    for (let k=0; m+12*k<MONTHS; k++) payA[m+12*k] += aA*Math.pow(r,k)*gift;
    for (let t=m; t<MONTHS; t++)      payM[t]      += aM*Math.pow(r,Math.floor((t-m)/12))*(gift/12)*(1-loss);
  }

  // Agregação anual
  const rows=[]; let cum=0, gross=0;
  for (const y of YEARS){
    let rA=0,rM=0,novos=0;
    for (let t=y.from;t<=y.to;t++){ rA+=payA[t]; rM+=payM[t]; novos+=a[t]; }
    let ativos=0; for (let m=0;m<=y.to;m++) ativos += a[m]*Math.pow(r,Math.floor((y.to-m)/12));
    const receita=rA+rM; cum+=receita; gross+=novos;
    rows.push({label:y.label,novos,rA,rM,receita,cum,ativos});
  }

  // Run-rate em regime de cruzeiro: base completa estável durante um ano inteiro
  const steady = target*gift*((1-pctM) + pctM*(1-loss));

  // Tabela
  document.querySelector("#tbl tbody").innerHTML = rows.map(o=>`
    <tr><td>${o.label}</td><td>${fmtN(o.novos)}</td><td>${fmtEUR(o.rM)}</td>
    <td>${fmtEUR(o.rA)}</td><td>${fmtEUR(o.receita)}</td>
    <td class="cum">${fmtEUR(o.cum)}</td><td>${fmtN(o.ativos)}</td></tr>`).join("");

  // Destaques
  document.getElementById("hlCum").textContent   = fmtEUR(cum);
  document.getElementById("hlRun").textContent   = fmtEUR(rows[3].receita);
  document.getElementById("hlSS").textContent    = fmtEUR(steady) + "/ano";
  document.getElementById("hlGross").textContent = fmtN(gross);

  drawChart(rows);
}

// Gráfico SVG nativo: barras empilhadas (DD mensal + anual) e linha da acumulada
function drawChart(rows){
  const W=860, H=300, padL=64, padR=20, padT=16, padB=36;
  const iw=W-padL-padR, ih=H-padT-padB;
  const maxBar = Math.max(...rows.map(o=>o.receita));
  const maxCum = rows[rows.length-1].cum;
  const maxY = Math.max(maxBar, maxCum)*1.08 || 1;
  const x = i => padL + iw*(i+0.5)/rows.length;
  const y = v => padT + ih*(1 - v/maxY);
  const bw = Math.min(72, iw/rows.length*0.45);

  let s = `<svg viewBox="0 0 ${W} ${H}" width="100%" role="img" aria-label="Receita anual e acumulada por ano" style="display:block">`;

  // Grelha + eixo Y
  const steps=4;
  for (let i=0;i<=steps;i++){
    const v=maxY*i/steps, yy=y(v);
    s += `<line x1="${padL}" y1="${yy}" x2="${W-padR}" y2="${yy}" stroke="#eef1ee" stroke-width="1"/>`;
    s += `<text x="${padL-8}" y="${yy+4}" text-anchor="end" font-size="11" fill="#5a6b64">${fmtK(v)}</text>`;
  }

  // Barras empilhadas
  rows.forEach((o,i)=>{
    const cx=x(i), x0=cx-bw/2;
    const hM=ih*o.rM/maxY, hA=ih*o.rA/maxY;
    const yM=y(o.rM), yA=y(o.rM+o.rA);
    s += `<rect x="${x0}" y="${yM}" width="${bw}" height="${Math.max(hM,0)}" fill="#0f6b5c" rx="3"/>`;
    s += `<rect x="${x0}" y="${yA}" width="${bw}" height="${Math.max(hA,0)}" fill="#7fb3a5" rx="3"/>`;
    s += `<text x="${cx}" y="${yA-6}" text-anchor="middle" font-size="11" font-weight="600" fill="#1c2b26">${fmtK(o.receita)}</text>`;
    s += `<text x="${cx}" y="${H-padB+18}" text-anchor="middle" font-size="12" fill="#5a6b64">${o.label}</text>`;
  });

  // Linha da acumulada
  const pts = rows.map((o,i)=>`${x(i)},${y(o.cum)}`).join(" ");
  s += `<polyline points="${pts}" fill="none" stroke="#c9a227" stroke-width="2.5"/>`;
  rows.forEach((o,i)=>{
    s += `<circle cx="${x(i)}" cy="${y(o.cum)}" r="4" fill="#c9a227"/>`;
    s += `<text x="${x(i)}" y="${y(o.cum)-9}" text-anchor="middle" font-size="11" font-weight="700" fill="#c9a227">${fmtK(o.cum)}</text>`;
  });

  s += `</svg>`;
  document.getElementById("chart").innerHTML = s;
}

["target","gift","churn","pctm","loss","ramp"].forEach(id=>
  document.getElementById(id).addEventListener("input", simulate));
simulate();
</script>
</body>
</html>
